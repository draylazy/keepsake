rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Allowed album styles
    function isValidStyle(style) {
      return style in ['scrapbook', 'storybook', 'filmstrip', 'gallerywall', 'albumbook'];
    }

    match /albums/{code} {
      // Anyone can read an album by its code if it's less than 24 hours old
      allow get: if resource.data.createdAt > request.time.toMillis() - 86400000;
      // Allow listing ONLY for expired albums so our cleanup script can find them
      allow list: if resource.data.createdAt <= request.time.toMillis() - 86400000;
      
      // Allow creation for signed-in users only
      allow create: if request.auth != null
                    // Cannot overwrite existing album
                    && !exists(/databases/$(database)/documents/albums/$(code))
                    // Validate fields
                    && isValidStyle(request.resource.data.style)
                    && request.resource.data.title.size() <= 60
                    && request.resource.data.note.size() <= 200
                    && request.resource.data.count >= 1
                    && request.resource.data.count <= 15;
                    
      allow update: if false;
      // Allow delete ONLY for expired albums
      allow delete: if resource.data.createdAt <= request.time.toMillis() - 86400000;
      
      match /photos/{index} {
        // Anyone can read the photos if they are less than 24h old
        allow get: if resource.data.createdAt > request.time.toMillis() - 86400000;
        allow list: if resource.data.createdAt <= request.time.toMillis() - 86400000;
        
        // Allow creation for signed-in users
        allow create: if request.auth != null
                      // Data must be a base64 string under ~300KB
                      && request.resource.data.data is string
                      && request.resource.data.data.size() < 300000
                      // Index must be a valid number matching the limit
                      && request.resource.data.index >= 0
                      && request.resource.data.index <= 14;
                      
        // Allow update only if false
        allow update: if false;
        // Allow delete for expired photos
        allow delete: if resource.data.createdAt <= request.time.toMillis() - 86400000;
      }
    }
  }
}
